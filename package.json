{
  "name": "iv-switchboard",
  "productName": "IV Switchboard",
  "version": "0.1.2",
  "description": "Infinite Variance tray meter: what's left on your Claude Code, Codex and Hermes, when it resets, and what each task used.",
  "author": "Infinite Variance",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/hollisorg/iv-switchboard.git"
  },
  "homepage": "https://infinitevariance.ai",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "playwright": "^1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "ai.infinitevariance.switchboard",
    "productName": "IV Switchboard",
    "copyright": "© 2026 Infinite Variance",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "IV Switchboard",
      "uninstallDisplayName": "IV Switchboard",
      "artifactName": "IV-Switchboard-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "build/licenses",
        "to": "licenses"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hollisorg",
        "repo": "iv-switchboard",
        "releaseType": "draft"
      }
    ]
  }
}
